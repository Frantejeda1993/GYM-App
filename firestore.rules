rules_version = '2';

// Reglas de seguridad de GYM App.
// Para invitar a alguien: añade su email a la lista de invited() y publica las reglas
// en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
        'frantejeda1993@gmail.com',
  	'nachogleon@gmail.com'
        ];
    }

    function isOwner(uid) {
      return invited() && request.auth.uid == uid;
    }

    // Datos personales: solo el propio usuario.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Sesiones: se pueden corregir o reabrir (también las finalizadas); una finalizada no se borra.
      match /sessions/{sessionId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if isOwner(uid) && resource.data.status != 'done';
      }

      // routines, weekOverrides, bodyMetrics
      match /{sub}/{docId} {
        allow read, write: if isOwner(uid) && sub != 'sessions';
      }
    }

    // Fotos opcionales del ejercicio (inicio y final): data URL de menos de ~150 KB cada una.
    function smallField(f) {
      return !(f in request.resource.data)
        || request.resource.data[f] == null
        || request.resource.data[f].size() < 150000;
    }
    function smallImage() {
      return smallField('imageData') && smallField('imageData2');
    }

    // Rutinas compartidas con la comunidad: las ve cualquier invitado; solo el autor las crea, cambia o retira.
    match /publicRoutines/{id} {
      allow read: if invited();
      allow create: if invited()
        && request.resource.data.authorUid == request.auth.uid
        && id.matches(request.auth.uid + '_.*');
      allow update: if invited()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if invited() && resource.data.authorUid == request.auth.uid;
    }

    // Catálogo compartido de ejercicios creados por usuarios.
    match /exercises/{id} {
      allow read: if invited();
      allow create: if invited()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'user'
        && smallImage();
      allow update: if invited()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.source == 'user'
        && smallImage();
      allow delete: if false; // se archivan, no se borran
    }
  }
}
